{
  "name": "fcp-mpdp-journey-test-suite",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=24"
  },
  "author": "Defra DDTS",
  "contributors": [
    "Rana Salem <rana.salem@defra.gov.uk>",
    "John Watson <john.watson1@defra.gov.uk>",
    "Jayne Elliott <jayne.elliott@defra.gov.uk>",
    "Lawrence Sithole <Lawrence.Sithole@defra.gov.uk>"
  ],
  "license": "OGL-UK-3.0",
  "scripts": {
    "create:folders": "mkdir -p allure-results && mkdir -p allure-report",
    "test": "node --env-file-if-exists=.env node_modules/.bin/playwright test",
    "test:debug": "node --env-file-if-exists=.env node_modules/.bin/playwright test --debug",
    "test:browserstack": "node --env-file-if-exists=.env node_modules/.bin/browserstack-node-sdk playwright test --config=playwright.browserstack.config.js",
    "test:all": "npm run test && npm run test:browserstack",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "report": "allure generate allure-results --single-file --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:publish": "npm run report; ./bin/publish-tests.sh",
    "zap:start": "/zap/zap.sh -daemon -host 0.0.0.0 -port 8080 -silent -nostdout -config api.addrs.addr.name=.* -config api.addrs.addr.regex=true -config api.disablekey=true -config anticsrf.tokens.token.name=crumb",
    "docker:test": "npm run create:folders && docker compose run --build --rm -e TEST_SCRIPT=test fcp-mpdp-journey-test-suite",
    "docker:test:browserstack": "npm run create:folders && docker compose run --build --rm -e TEST_SCRIPT=test:browserstack fcp-mpdp-journey-test-suite"
  },
  "dependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.59.1",
    "allure-commandline": "2.34.1",
    "allure-playwright": "3.3.2",
    "browserstack-local": "1.5.13",
    "browserstack-node-sdk": "1.56.1",
    "global-agent": "3.0.0",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "eslint": "9.31.0",
    "neostandard": "0.12.2"
  }
}
