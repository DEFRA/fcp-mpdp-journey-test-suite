BROWSERSTACK_USER=
BROWSERSTACK_KEY=
BROWSERSTACK_BUILD_NAME="FCP MPDP Local"

# Target URL (enables local mode: retries=0, trace=on, video=on)
# Docker Compose overrides this with http://host.docker.internal:3000
BASE_URL=http://localhost:3000

# CDP deployed environment only (injected by platform)
# ENVIRONMENT=dev
# HTTP_PROXY=http://localhost:3128
